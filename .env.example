# LastMile — environment
# Copy to .env.local and fill in. Everything marked FREE is a free tier that
# needs no credit card. The pipeline runs degraded-with-zero-of-these, so you
# can start with nothing and add keys as you go.

# ————— database (required) —————
# Supabase → Project settings → Database → Connection string (Session pooler)
DATABASE_URL=

# ————— auth (required) —————
# generate: npx auth secret
AUTH_SECRET=
AUTH_TRUST_HOST=true

# GitHub OAuth app → github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ————— landing CTA switch —————
# waitlist | open
NEXT_PUBLIC_SIGNUP_MODE=waitlist

# ============================================================================
# ENGINE — models (pick one; the chain tries them top-down and fails over)
# ============================================================================
# Each is optional. Add any one and the Research Agent upgrades from
# search-only synthesis to a full synthesized brief.

# 40 req/min · build.nvidia.com · OpenAI-compatible, hosted by NVIDIA, no card
# Chat: nemotron-3-super-120b (default) · laguna-xs-2.1 (coding specialist,
# pinned to the code agent) · kimi-k3. Other catalog models hang or leak
# reasoning into content — smoke-test before adding them to the chain.
NVIDIA_API_KEY=
# NIM_MODEL=nvidia/nemotron-3-super-120b-a12b

# FREE · aistudio.google.com/apikey · 1M context, no card
GEMINI_API_KEY=
# optional model override
# GEMINI_MODEL=gemini-2.5-flash

# FREE · console.groq.com/keys · fastest tokens/sec, no card
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# FREE · cloud.cerebras.ai · ~1M tokens/day, no card
CEREBRAS_API_KEY=
# CEREBRAS_MODEL=llama-3.3-70b

# FREE · openrouter.ai/keys · ':free' catalog, no card
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Reorder the chain, e.g. to prefer Groq
# AI_PROVIDER_ORDER=groq,gemini,cerebras,openrouter

# ============================================================================
# ENGINE — web search
# ============================================================================
# Optional. Without either key the agent falls back to keyless search + page
# reading, which still returns real, citable sources.

# FREE · app.tavily.com/home · 1,000 credits/month, built for agents
TAVILY_API_KEY=

# FREE · dashboard.exa.ai/api-keys · monthly free credits
EXA_API_KEY=

# SEARCH_PROVIDER_ORDER=tavily,exa,keyless

# ============================================================================
# PIPELINE — live QA browser (optional)
# ============================================================================

# cloud.browser-use.com — runs every test flow in a cloud browser session, so
# live QA works on machines with no Chrome/Edge installed. When set it leads;
# without it the pipeline uses a locally installed Chromium instead.
BROWSER_USE_API_KEY=
# BROWSER_USE_BASE_URL=https://api.browser-use.com/api/v3

# ============================================================================
# PIPELINE — deploy targets, github, admin
# ============================================================================

# GitHub token (classic, repo scope) — the PLATFORM-HOSTED account for users
# who have not linked their own GitHub via OAuth (their token always wins).
# Repos for unlinked users land in this account (e.g. the lastmile-builds org).
# Also settable at runtime in Admin → Infrastructure (stored encrypted).
GITHUB_TOKEN=

# Vercel token — production deploys (vercel.com/account/tokens). Required for
# the deploy stage. VERCEL_TEAM_ID is optional (team deploys).
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Render API key — deploy fallback when Vercel fails and a repo exists.
RENDER_API_KEY=

# Comma-separated emails with access to /admin. When unset, the first account
# to sign up is treated as the operator (single-player installs).
# ADMIN_EMAILS=you@example.com

# Master secret for encrypting provider keys stored via Admin → Providers.
# Falls back to AUTH_SECRET when unset. Generate: npx auth secret
# APP_ENCRYPTION_KEY=
