# ── required ────────────────────────────────────────────────────────────────

# Postgres (Supabase session/transaction pooler). The app and the worker both
# connect here; the queue lives in this database.
DATABASE_URL=

# Auth.js. Generate with: npx auth secret
AUTH_SECRET=

# ── platform credentials (the defaults every user falls back to) ────────────

# Creates a repo per project when the user has not linked their own GitHub.
# Classic PAT with `repo` scope, or a fine-grained PAT with Administration:write
# so it can create repositories.
GITHUB_TOKEN=

# Deploys generated projects when the user has not connected their own Vercel.
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Comma-separated operator accounts allowed into /admin
ADMIN_EMAILS=

# ── auth providers ──────────────────────────────────────────────────────────

AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# waitlist | open
NEXT_PUBLIC_SIGNUP_MODE=open

# ── models ──────────────────────────────────────────────────────────────────
# All of these speak the OpenAI chat-completions dialect, so one client covers
# them and the chain fails over in order. Add any one to make the pipeline live.

GROQ_API_KEY=
GROQ_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
NVIDIA_API_KEY=
NVIDIA_MODEL=

# Override the failover order, e.g. "groq,gemini,openrouter"
AI_PROVIDER_ORDER=

# ── web search (optional — keyless fallback is always on) ───────────────────

TAVILY_API_KEY=
EXA_API_KEY=

# ── live QA (optional — falls back to a local browser) ──────────────────────

BROWSER_USE_API_KEY=
BROWSER_USE_BASE_URL=

# ── worker ──────────────────────────────────────────────────────────────────

# Identifies this worker process in job leases.
WORKER_ID=
# How many jobs one worker may run at once.
WORKER_CONCURRENCY=1
