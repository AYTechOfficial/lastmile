# ── required ────────────────────────────────────────────────────────────────

# Postgres (Supabase session/transaction pooler). The app and the worker both
# connect here; the queue lives in this database.
DATABASE_URL=

# Auth.js. Generate with: npx auth secret
AUTH_SECRET=

# ── platform credentials (the defaults every user falls back to) ────────────

# Creates a repo per project when the user has not linked their own GitHub.
# Classic PAT with `repo` scope, or a fine-grained PAT with Administration:write
# so it can create repositories.
GITHUB_TOKEN=

# Deploys generated projects when the user has not connected their own Vercel.
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Comma-separated operator accounts allowed into /admin
ADMIN_EMAILS=

# ── auth providers ──────────────────────────────────────────────────────────

AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# waitlist | open
NEXT_PUBLIC_SIGNUP_MODE=open

# ── models ──────────────────────────────────────────────────────────────────
# All of these speak the OpenAI chat-completions dialect, so one client covers
# them and the chain fails over in order. Add any one to make the pipeline live.
#
# ORDER IS THE FAILOVER ORDER. The first provider below is the one a free run
# leads with, and its model list is ordered by measured throughput (fastest
# first), so a run falls through the quick models before the slow ones.

# 1412 / TrueModel — the free tier's primary. Models were benchmarked with a
# fixed prompt and only the ones that answered are listed. The admin catalog
# overrides this order without a deploy.
TRUEMODEL_API_KEY=

# HCNSEC — verified DeepSeek/GLM/Qwen/Step catalog (https://api.hcnsec.cn/v1)
HCNSEC_API_KEY=

# Aion Labs — uncensored, unrestricted catalog (https://api.aionlabs.ai/v1)
AION_API_KEY=

GROQ_API_KEY=
GROQ_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
NVIDIA_API_KEY=
NVIDIA_MODEL=

# Override the failover order, e.g. "groq,gemini,openrouter"
AI_PROVIDER_ORDER=

# ── web search ──────────────────────────────────────────────────────────────
# The Research Agent walks Tavily → Exa → DuckDuckGo → Wikipedia and uses the
# first that answers. Only the first two need a key; the last two are keyless,
# so search works with nothing configured here at all.

TAVILY_API_KEY=
EXA_API_KEY=

# ── live QA ─────────────────────────────────────────────────────────────────
# The cloud browser is a PRO feature. Pro runs use it when this key resolves,
# and the run page embeds the live session. Free runs — and any Pro run without
# a key — verify in an embedded local browser instead. Either way the stage runs
# against the deployed URL; only the driver changes.

BROWSER_USE_API_KEY=
BROWSER_USE_BASE_URL=

# ── worker ──────────────────────────────────────────────────────────────────

# Identifies this worker process in job leases.
WORKER_ID=
# How many jobs one worker may run at once.
WORKER_CONCURRENCY=1

# ── waking the runner ───────────────────────────────────────────────────────
# The app queues work and then wakes a runner. Without RUNNER_REPO the wake is a
# silent no-op, so queued work waits for a sweep instead of starting at once.

# owner/name of the repo holding the runner workflow.
RUNNER_REPO=
# Branch/tag the workflow runs from.
RUNNER_REF=main
RUNNER_WORKFLOW=runner.yml
# Optional: a token just for dispatching. Falls back to GITHUB_TOKEN.
RUNNER_TOKEN=

# Shared secret between the database's cron job and /api/runner/wake. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# It is a doorbell, not a key — it can reclaim leases and wake a runner, nothing else.
WAKE_SECRET=
