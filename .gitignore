# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# agent build workspaces (generated codebases live here)
.builds/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# catalyst appsail deploy artifacts (app-config.json carries env secrets)
/deployable
app-config.json
.catalystrc
.catalyst/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# visual-QA output
/shots/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev scratch (never committed)
.freebuff/
*.log
probe-*.mjs
shots.mjs
.dev-pid
